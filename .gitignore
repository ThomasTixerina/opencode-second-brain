# Obsidian — workspace state (machine-local)
.obsidian/workspace
.obsidian/workspace.json
.obsidian/cache

# Plugin binaries (downloaded by Obsidian from Community Plugins)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css

# Theme binaries (downloaded by Obsidian)
.obsidian/themes/

# Personal / client content (user-specific, not template)
test-*.md
daily/*.md
!daily/.gitkeep
kanban/*.md
!kanban/.gitkeep
memory/project-*.md
memory/pending-*.md
memory/user*.md
memory/flet-*.md
memory/n8n-miconsul-*.md
memory/miconsuluno-*.md
memory/opencode-voice-*.md
memory/voice-*.md
memory/pol*.md
memory/lista-de-precios-*.md
memory/sesiones.md
memory/sucursales-*.md
memory/workflow-*.md
memory/session-*.md
memory/thomas-*.md
memory/cmasdental-*.md

# OS
Thumbs.db
.DS_Store

# Editor
*.swp
*.swo
