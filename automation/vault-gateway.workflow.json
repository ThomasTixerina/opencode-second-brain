        "jsCode": "const items = $input.all().map(item => ({\n  json: {\n    path: item.json.body.path,\n    content: Buffer.from(item.json.body.content).toString('base64'),\n    commitMessage: item.json.body.commitMessage,\n    sha: item.json.body.sha || undefined,\n  }\n}));\nreturn items;"
      }
